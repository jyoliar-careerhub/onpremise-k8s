#---- Variables -----

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_python_interpreter=/usr/bin/python3

# CRI-O 버전
crio_version=1.35

# Kubernetes (k8s) vars...
kubernetes_version=1.35
kubelet_version=1.35.0-1.1
kubeadm_version=1.35.0-1.1
kubectl_version=1.35.0-1.1
pod_network_cidr=10.244.0.0/16
# optional vip to be used with keepalived
virtual_ip=10.54.235.61
# change to your interface
network_interface=eth0
smoke_test_node_port=31111
kubelet_workers_eviction_hard=memory.available<10%
kubelet_masters_eviction_hard=memory.available<10%
etcd_version=v3.5.12
haproxy_stats_port=9000
ha_proxy_port=5446
# haproxy port for etcd
etcd_proxy_port=3379
proxy_port=6443
image_pull_type=always
# setup: public or private, put private to use private repo and public to use public repos
setup=private
encoded_secret="zm1J79tER3oeEIeQUWT6F1Vdq8Kzj/z54jqR8xj/RRE="

# Container images: to be changed if using private container registry
flannel_container_image=<container_registry>/flannel:v0.24.0
kubeapi_server_container_image=<container_registry>/kube-apiserver:v1.35.0
kubescheduler_container_image=<container_registry>/kube-scheduler:v1.35.0
kubecontroller_manager_container_image=<container_registry>/kube-controller-manager:v1.35.0
kubeproxy_container_image=<container_registry>/kube-proxy:v1.35.0
haproxy_container_image=<container_registry>/haproxy:2.8
coredns_container_image=<container_registry>/coredns:v1.11.1
kubepause_container_image=<container_registry>/pause:3.9

# Optional, needed when using private registry
container_registry=<container_registry>
container_registry_username=<registry_user>
container_registry_password=<registry_password>
container_registry_email=<email>

