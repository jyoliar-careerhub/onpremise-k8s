#!/bin/bash
set -euo pipefail

echo "=== Subnet Router 강등 ==="
echo "[1/2] SR 설정 제거..."
tailscale set \
  --advertise-routes= \
  --accept-routes=false
echo "  완료."

echo "[2/2] 상태 확인..."
# 정보성 출력 — 실패해도 강등 결과와 무관하므로 유닛을 죽이지 않는다
tailscale status || echo "  (정보) tailscale status 실패 — 무시"
echo ""
echo "참고: 보호 ip rule(priority 5269)은 유지됩니다."
