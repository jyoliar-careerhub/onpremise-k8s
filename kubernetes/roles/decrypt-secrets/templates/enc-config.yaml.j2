kind: EncryptionConfig
apiVersion: v1
resources:
  - resources:
    - secrets
    providers:
    - identity: {}
    - aescbc:
        keys:
{# encoded_secret 은 키 목록(group_vars/all/vault.yml) — encrypt-secrets 와 같은 변수 · 같은 순서. #}
{% for key in encoded_secret %}
        - name: {{ key.name }}
          secret: {{ key.secret }}
{% endfor %}
