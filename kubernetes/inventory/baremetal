#---- Variables -----

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_python_interpreter=/usr/bin/python3

# 인프라 제공자 설정: baremetal 또는 aws
# - baremetal: kube-vip 사용 (ARP 모드)
# - aws: AWS NLB 사용 (nlb_dns_name 변수 필요)
infra_provider=baremetal

# AWS NLB 설정 (infra_provider=aws 일 때만 사용)
#nlb_dns_name=k8s.jyo-liar.com

# CRI-O 버전
crio_version=1.34
crio_repo_base_url=https://download.opensuse.org

# Kubernetes (k8s) vars...
kubernetes_version=1.34
# 패치 단위 목표 버전 — kubeadm upgrade apply·kubeadm-config 템플릿이 사용
kubernetes_full_version=1.34.9
# apiserver Secret 암호화(enc-config.yaml) — encrypt-secrets 적용이 끝난 클러스터에서만 true
# (신규 init 시점에는 파일이 없어 true면 apiserver 기동 실패)
apiserver_encryption_enabled=true
kubelet_version=1.34.9-1.1
kubeadm_version=1.34.9-1.1
kubectl_version=1.34.9-1.1
pod_network_cidr=10.244.0.0/16
internal_network_cidr=10.18.0.0/16
# VIP 설정 (kube-vip 또는 keepalived)
virtual_ip=10.18.1.1
# network_interface는 호스트/그룹별로 설정됨 (Pi: eth1, ubuntu-notebook: enp2s0)

# kube-vip 설정 (infra_provider=baremetal 일 때 사용)
kube_vip_image=ghcr.io/kube-vip/kube-vip:v0.8.7
kube_vip_arp_enabled=true
kube_vip_lb_enabled=true
# Service LoadBalancer IP 범위 (CIDR 또는 Range 중 하나 선택)
# kube_vip_lb_cidr=10.54.235.70/29
kube_vip_lb_range=10.18.100.2-10.18.100.254

smoke_test_node_port=31111
kubelet_workers_eviction_hard=memory.available<10%
kubelet_masters_eviction_hard=memory.available<10%
etcd_version=v3.5.21
proxy_port=6443
image_pull_type=always
# setup: public or private, put private to use private repo and public to use public repos
setup=public
# encoded_secret(apiserver Secret 암호화 키 목록)은 group_vars/all/vault.yml 에 있다 — ansible-vault 로 암호화
service_account_issuer=https://k8s-oidc.jyo-liar.com

# Container images: to be changed if using private container registry
flannel_version=v0.27.4
flannel_cni_plugin_version=v1.8.0-flannel1
kubeapi_server_container_image=<container_registry>/kube-apiserver:v1.34.0
kubescheduler_container_image=<container_registry>/kube-scheduler:v1.34.0
kubecontroller_manager_container_image=<container_registry>/kube-controller-manager:v1.34.0
kubeproxy_container_image=<container_registry>/kube-proxy:v1.34.0
coredns_container_image=<container_registry>/coredns:v1.11.1
kubepause_container_image=<container_registry>/pause:3.9

# Optional, needed when using private registry
container_registry=<container_registry>
container_registry_username=<registry_user>
container_registry_password=<registry_password>
container_registry_email=<email>


