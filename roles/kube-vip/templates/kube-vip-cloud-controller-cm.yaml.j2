apiVersion: v1
kind: ConfigMap
metadata:
  name: kubevip
  namespace: kube-system
data:
{% if kube_vip_lb_cidr is defined %}
  # CIDR 범위로 IP 할당 (예: 192.168.1.220/29)
  cidr-global: "{{ kube_vip_lb_cidr }}"
{% elif kube_vip_lb_range is defined %}
  # IP 범위로 할당 (예: 192.168.1.220-192.168.1.230)
  range-global: "{{ kube_vip_lb_range }}"
{% else %}
  # 기본: VIP와 같은 서브넷에서 범위 지정 필요
  # 아래 예시를 환경에 맞게 수정하세요
  range-global: "{{ kube_vip_lb_range | default('10.54.235.70-10.54.235.80') }}"
{% endif %}
